{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Cortex Debug",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",

            "preLaunchTask": "build",
            "executable": "${workspaceFolder}/build_F429ZI/STM32F429ZI.elf",

            "servertype": "openocd",
            "serverpath": "C:/MCU_programming/Tools/OpenOCD/bin/openocd.exe",
            "gdbPath": "C:/MCU_programming/Tools/GNU_compiler/bin/arm-none-eabi-gdb.exe",
            "device": "STM32F429ZI",
            "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],

            "svdFile": "${workspaceFolder}/STM32F429.svd",
            "runToEntryPoint": "main",

            "liveWatch": { "enabled": true, "samplesPerSecond": 4 },
            "showDevDebugOutput": "raw"
        }
    ]
}