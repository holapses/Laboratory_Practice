  34:Core/Src/main.c **** void run_advance(void) {
  35:Core/Src/main.c ****     // LEDS - PB4 PB5 PB6 PB8
  36:Core/Src/main.c ****     // BUTTONS - PB9 PB10
  37:Core/Src/main.c ****     RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
  38:Core/Src/main.c **** 
  39:Core/Src/main.c ****     GPIOB->MODER &= ~(GPIO_MODER_MODER4 | GPIO_MODER_MODER5 | GPIO_MODER_MODER6 | GPIO_MODER_MODER8
  40:Core/Src/main.c ****     GPIOB->MODER |= (GPIO_MODER_MODER4_0 | GPIO_MODER_MODER5_0 | GPIO_MODER_MODER6_0 | GPIO_MODER_M
  41:Core/Src/main.c **** 
  42:Core/Src/main.c ****     GPIOB->MODER &= ~(GPIO_MODER_MODER9 | GPIO_MODER_MODER10); //Clean button bits
  43:Core/Src/main.c ****     GPIOB->PUPDR &= ~(GPIO_PUPDR_PUPDR9 | GPIO_PUPDR_PUPDR10); //Clean pupdr bits
  44:Core/Src/main.c ****     GPIOB->PUPDR |= (GPIO_PUPDR_PUPDR9_0 | GPIO_PUPDR_PUPDR10_0); //Pull up for bittons
  45:Core/Src/main.c **** 
  46:Core/Src/main.c ****     while(1) {
  47:Core/Src/main.c ****         test++;
  48:Core/Src/main.c ****         shim();
  49:Core/Src/main.c **** 
  50:Core/Src/main.c ****         if((GPIOB->IDR & GPIO_IDR_ID9) == 0) {
  51:Core/Src/main.c ****             while(drebezg_counter <= DREBEZG_TIME) drebezg_counter++;
  52:Core/Src/main.c ****             drebezg_counter = 0;
  53:Core/Src/main.c ****             if((GPIOB->IDR & GPIO_IDR_ID9) == 0) {
  54:Core/Src/main.c ****                 button1_counter = 0;
  55:Core/Src/main.c ****                 while((GPIOB->IDR & GPIO_IDR_ID9) == 0) button1_counter++; //Wait holding
  56:Core/Src/main.c ****                 if(button1_counter <= SWITCH_TIME) {
  57:Core/Src/main.c ****                     led_switch(0);
  58:Core/Src/main.c ****                 } else {
  59:Core/Src/main.c ****                     time_b1 = button1_counter;
  60:Core/Src/main.c ****                 }
  61:Core/Src/main.c ****             }
  62:Core/Src/main.c ****         }
  63:Core/Src/main.c **** 
  64:Core/Src/main.c ****         if((GPIOB->IDR & GPIO_IDR_ID10) == 0) {
  65:Core/Src/main.c ****             while(drebezg_counter <= DREBEZG_TIME) drebezg_counter++;
  66:Core/Src/main.c ****             drebezg_counter = 0;
  67:Core/Src/main.c ****             if((GPIOB->IDR & GPIO_IDR_ID10) == 0) {
  68:Core/Src/main.c ****                 button2_counter = 0;
  69:Core/Src/main.c ****                 while((GPIOB->IDR & GPIO_IDR_ID10) == 0) button2_counter++; //Wait holding
  70:Core/Src/main.c ****                 if(button2_counter <= SWITCH_TIME) {
  71:Core/Src/main.c ****                     led_switch(1);
  72:Core/Src/main.c ****                     button2_counter = 0;
  73:Core/Src/main.c ****                 } else {
  74:Core/Src/main.c ****                     time_b2 = button2_counter;
  75:Core/Src/main.c ****                     led_brightness(time_b1, time_b2);
  76:Core/Src/main.c ****                 }
  77:Core/Src/main.c ****             }
  78:Core/Src/main.c ****         }
  79:Core/Src/main.c ****     }
  80:Core/Src/main.c **** }
